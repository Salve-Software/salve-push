{
  "name": "@salve-push/protocol",
  "version": "0.0.1",
  "description": "Shared TypeScript types for the Salve Push OTA protocol, generated from /protocol/openapi.yaml",
  "license": "Apache-2.0",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": ["dist"],
  "scripts": {
    "generate": "openapi-typescript ../../protocol/openapi.yaml -o src/generated.ts",
    "build": "tsc -p tsconfig.json",
    "lint": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@babel/runtime": "^7.25.0",
    "@noble/ed25519": "^2.1.0",
    "@noble/hashes": "^1.5.0"
  },
  "devDependencies": {
    "openapi-typescript": "^7.0.0",
    "typescript": "^5.5.0",
    "vitest": "^2.1.0"
  }
}
