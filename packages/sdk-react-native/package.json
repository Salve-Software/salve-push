{
  "name": "react-native-salve-push",
  "version": "0.0.1",
  "description": "React Native SDK for Salve Push — check, download, verify and install OTA updates from a self-hosted salve-push-server",
  "license": "Apache-2.0",
  "author": "Salve Software",
  "homepage": "https://github.com/salvesoftware/salve-push#readme",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "android",
    "ios",
    "cpp",
    "nitrogen",
    "nitro.json",
    "*.podspec",
    "react-native.config.js",
    "!android/build",
    "!android/.cxx",
    "!ios/build"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "lint": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "nitrogen": "nitrogen"
  },
  "peerDependencies": {
    "react-native": ">=0.79.0",
    "react-native-nitro-modules": ">=0.37.0"
  },
  "dependencies": {
    "@babel/runtime": "^7.25.0",
    "@salve-push/protocol": "workspace:*"
  },
  "devDependencies": {
    "nitrogen": "^0.37.1",
    "react-native-nitro-modules": "^0.37.1",
    "typescript": "^5.5.0",
    "vitest": "^2.1.0"
  }
}
