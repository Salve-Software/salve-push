{
  "name": "salve-push",
  "private": true,
  "description": "Salve Push — OSS monorepo: OTA server (Go), React Native SDK, CLI, and shared protocol",
  "packageManager": "pnpm@9.12.0",
  "scripts": {
    "protocol:generate": "pnpm --filter @salve-push/protocol generate",
    "build": "pnpm -r --filter=./packages/* build",
    "lint": "pnpm -r --filter=./packages/* lint",
    "test": "pnpm -r --filter=./packages/* test"
  },
  "devDependencies": {
    "@changesets/cli": "^2.27.0",
    "typescript": "^5.5.0"
  }
}
